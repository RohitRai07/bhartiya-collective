# ============================================
# BHARAT COLLECTIVE FOUNDATION
# INTEGRATION ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# ============================================
# 1. SMS PROVIDER CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add your paid SMS provider credentials here.
# E.g., Twilio, MSG91, Textlocal, etc.
# ============================================
SMS_API_URL=https://api.smsprovider.com/v1/send
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=BCFNDN
SMS_TEMPLATE_ID_SHORTLIST=your_shortlist_template_id
SMS_TEMPLATE_ID_SELECT=your_select_template_id
SMS_TEMPLATE_ID_GENERAL=your_general_template_id

# ============================================
# 2. EMAIL PROVIDER CONFIGURATION (SMTP)
# FINAL CONFIGURATION REQUIRED:
# Add your SMTP provider credentials here.
# E.g., SendGrid, Amazon SES, Mailgun, SMTP.
# ============================================
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Bharat Collective Foundation" <noreply@bharatcollective.org>

# ============================================
# 3. WHATSAPP BUSINESS API CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add your Meta/WhatsApp Business API credentials here.
# ============================================
WHATSAPP_API_URL=https://graph.facebook.com/v17.0/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_KEY=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_TEMPLATE_SHORTLIST=shortlist_template_name
WHATSAPP_TEMPLATE_PUBLISH=publish_template_name

# ============================================
# 4. RAZORPAY PAYMENT CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add Razorpay Key ID, Key Secret and Webhook Secret here.
# Never expose RAZORPAY_KEY_SECRET to the frontend.
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
