# ============================================
# BHARAT COLLECTIVE FOUNDATION
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================

# Frontend Configuration
VITE_API_BASE_URL=/api

# Server Configuration
PORT=5000
NODE_ENV=production

# ============================================
# 1. SECURITY & CRYPTOGRAPHY
# REQUIRED FOR PRODUCTION:
# Generate strong, unique cryptographic secrets.
# E.g., `openssl rand -hex 32`
# ============================================
SESSION_SECRET=replace_with_strong_random_session_secret_min_32_chars
OTP_SECRET=replace_with_strong_random_otp_secret_min_32_chars
SESSION_EXPIRY_SECONDS=7200
IDLE_TIMEOUT_SECONDS=1800

# ============================================
# 2. ADMINISTRATOR CREDENTIALS
# ============================================
ADMIN_EMAIL=admin@bharatcollective.org
ADMIN_2FA_EMAIL=rohitraicr10@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_strong_admin_password
ADMIN_NAME=Chief Administrator (Bharat Collective)
ADMIN_PHONE=+918076802450

# ============================================
# 3. TWO-FACTOR AUTHENTICATION (2FA) / OTP
# ============================================
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================
# 4. RATE LIMITING
# ============================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_OTP_REQUEST_MAX=3
RATE_LIMIT_OTP_REQUEST_WINDOW_MS=300000
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=300000
RATE_LIMIT_ADMIN_API_MAX=100
RATE_LIMIT_ADMIN_API_WINDOW_MS=60000

# ============================================
# 5. SMS PROVIDER CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add your paid SMS provider credentials here.
# E.g., Twilio, MSG91, Textlocal, etc.
# ============================================
SMS_API_URL=https://api.smsprovider.com/v1/send
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=BCFNDN
SMS_TEMPLATE_ID_OTP=your_otp_dlt_template_id
SMS_TEMPLATE_ID_SHORTLIST=your_shortlist_template_id
SMS_TEMPLATE_ID_SELECT=your_select_template_id
SMS_TEMPLATE_ID_GENERAL=your_general_template_id

# ============================================
# 6. EMAIL PROVIDER CONFIGURATION (SMTP)
# FINAL CONFIGURATION REQUIRED:
# Add your SMTP provider credentials here.
# E.g., SendGrid, Amazon SES, Mailgun, SMTP.
# ============================================
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Bharat Collective Foundation" <noreply@bharatcollective.org>

# ============================================
# 7. WHATSAPP BUSINESS API CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add your Meta/WhatsApp Business API credentials here.
# ============================================
WHATSAPP_API_URL=https://graph.facebook.com/v17.0/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_KEY=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_TEMPLATE_OTP=otp_template_name
WHATSAPP_TEMPLATE_SHORTLIST=shortlist_template_name
WHATSAPP_TEMPLATE_PUBLISH=publish_template_name

# ============================================
# 8. RAZORPAY PAYMENT CONFIGURATION
# FINAL CONFIGURATION REQUIRED:
# Add Razorpay Key ID, Key Secret and Webhook Secret here.
# Never expose RAZORPAY_KEY_SECRET to the frontend.
# ============================================
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
